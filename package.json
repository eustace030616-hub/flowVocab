{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "tsx src/scripts/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "fetch:data": "bash src/scripts/import/fetch-data.sh",
    "import:english": "tsx src/scripts/import/import-english.ts",
    "import:german": "tsx src/scripts/import/import-german.ts",
    "import:licences": "tsx src/scripts/import/write-licences.ts",
    "export:frequency": "tsx src/scripts/import/collect-frequency-words.ts && ./.venv-data/bin/python src/scripts/import/wordfreq_export.py en data/en/frequency-words.txt data/en/wordfreq-zipf.json && ./.venv-data/bin/python src/scripts/import/wordfreq_export.py de data/de/frequency-words.txt data/de/wordfreq-zipf.json",
    "import:frequency": "tsx src/scripts/import/import-frequency.ts",
    "import:german-rank": "tsx src/scripts/import/import-german-rank.ts",
    "recompute:difficulty": "tsx src/scripts/import/recompute-difficulty.ts",
    "import:ding": "tsx src/scripts/import/import-ding.ts",
    "import:cedict": "tsx src/scripts/import/import-cedict.ts",
    "import:kaikki-glosses": "tsx src/scripts/import/import-kaikki-glosses.ts"
  },
  "dependencies": {
    "hono": "^4.11.1",
    "@hono/node-server": "^1.19.0",
    "mongoose": "^9.8.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
