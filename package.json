{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:web && tsx watch src/server/node.ts",
    "build": "npm run build:web",
    "build:web": "vite build --config web/vite.config.ts && node -e \"require('fs').cpSync('web/public','web/dist',{recursive:true})\"",
    "start": "tsx src/server/node.ts",
    "pull": "tsx src/scripts/worker/pull.ts",
    "parity": "tsx src/scripts/parity.ts",
    "serve": "tsx src/server/node.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.11.1",
    "mongoose": "^9.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  }
}
